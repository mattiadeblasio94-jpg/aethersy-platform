# Aethersy Console — variabili d'ambiente del BFF.
# In produzione i valori sono iniettati dal compose (vedi docker-compose.yml).
# Per lo sviluppo locale: copia in `console/.env` e carica con `node --env-file`.

NODE_ENV=development
PORT=3000

# URL interno dell'app Activepieces. In docker: http://app:80
# In sviluppo locale (app raggiungibile via localhost): http://127.0.0.1:8080
AP_INTERNAL_URL=http://127.0.0.1:8080
AP_PUBLIC_URL=https://app.aethersy.online

# Segreto di firma del cookie di sessione (openssl rand -hex 32).
CONSOLE_SESSION_SECRET=CHANGEME_openssl_rand_hex_32

# Chiave OpenRouter usata dall'AI Router (la stessa dello stack Activepieces).
OPENROUTER_API_KEY=

# Venice: generazione immagini/voce/video (OpenRouter copre solo testo+comprensione).
# Senza chiave le capability generative rispondono 503.
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- Metering / billing (piattaforma a consumo) ------------------------------
# Kill-switch: `true` abilita prenotazione e addebito. Richiede DB e Redis.
METERING_ENABLED=false
# Postgres per lo schema `metering` (stesso database dell'app). Parametri
# discreti: nessuna credenziale dentro una URL, nessun carattere da encodare.
# In docker il compose li passa da AP_POSTGRES_*.
CONSOLE_PGHOST=127.0.0.1
CONSOLE_PGPORT=5432
CONSOLE_PGUSER=postgres
CONSOLE_PGPASSWORD=CHANGEME
CONSOLE_PGDATABASE=activepieces
# Redis per rate limit (stessi parametri del compose).
CONSOLE_REDIS_HOST=127.0.0.1
CONSOLE_REDIS_PORT=6379
CONSOLE_REDIS_PASSWORD=
# Richieste AI al minuto per tenant/chiave.
METERING_RATE_PER_MINUTE=120
# Crediti di benvenuto al provisioning del primo accesso (0 = nessuno).
METERING_SIGNUP_CREDITS=0
