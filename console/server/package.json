{
  "name": "aethersy-console-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:schema": "node tools/gen-schema.mjs",
    "test:metering": "node tools/test-metering.mjs",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test:social": "npm run build && node tools/test-social-login.mjs",
    "test:connectors": "npm run build && node tools/test-connectors.mjs",
    "test:pdf": "npm run build && node tools/test-pdf.mjs",
    "test:research": "npm run build && node tools/test-research.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/openai": "^1.8.0",
    "@vercel/sdk": "^1.28.54",
    "dockerode": "^5.0.1",
    "dotenv": "^18.0.9",
    "fastify": "^5.2.0",
    "ioredis": "^6.0.0",
    "minio": "^8.0.7",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "stripe": "^23.1.0",
    "undici": "^8.12.3",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.0"
  }
}
