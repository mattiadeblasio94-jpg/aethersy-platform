{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/index.ts", "src/config.ts", "src/routes.ts", "src/ap.ts", "src/session.ts", "src/types/fastify.d.ts", "src/types/dockerode.d.ts", "src/pipeline/pdf-worker.ts"],
  "exclude": ["node_modules", "dist", "src/builder"]
}
