# =============================================================================
# aethersy — variabili d'ambiente
# Copia questo file in `.env` e compila i valori. MAI committare `.env`.
#   cp .env.example .env
# Genera i segreti con:
#   openssl rand -hex 16   -> AP_ENCRYPTION_KEY (32 hex char)
#   openssl rand -hex 32   -> AP_JWT_SECRET, AP_POSTGRES_PASSWORD, AP_REDIS_PASSWORD
# =============================================================================

# --- Versione immagine (pin obbligatorio, mai `latest`) ----------------------
# Ultima release stabile verificata su GitHub: 0.92.3-hotfix.1 (23/10/2026)
AP_VERSION=0.92.3-hotfix.1

# --- Core -------------------------------------------------------------------
AP_ENVIRONMENT=prod
# URL pubblico usato per webhook e redirect. DEVE essere raggiungibile da terzi.
AP_FRONTEND_URL=https://app.aethersy.online
# Hostname dedicato per il traffico MCP. Obbligatoriamente diverso da AP_FRONTEND_URL.
AP_MCP_URL=https://mcp.aethersy.online

# 32 caratteri hex (16 byte) — cifra le credenziali delle connessioni.
# SE PERSA, le connessioni salvate diventano irrecuperabili. Salvala offline.
AP_ENCRYPTION_KEY=CHANGEME_openssl_rand_hex_16
# 32 caratteri hex — firma i JWT.
AP_JWT_SECRET=CHANGEME_openssl_rand_hex_32

AP_TELEMETRY_ENABLED=false

# --- Database ---------------------------------------------------------------
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=CHANGEME_openssl_rand_hex_32

# --- Redis & queue ----------------------------------------------------------
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
# Redis gira con requirepass (vedi docker-compose.yml): user `default`.
AP_REDIS_USER=default
AP_REDIS_PASSWORD=CHANGEME_openssl_rand_hex_32
# Dashboard BullMQ. Richiede credenziali proprie se abilitata.
AP_QUEUE_UI_ENABLED=false
AP_QUEUE_UI_USERNAME=
AP_QUEUE_UI_PASSWORD=

# --- Esecuzione -------------------------------------------------------------
# NOTA: app e worker condividono questo `.env` (env_file). Le variabili di
# esecuzione/rete (AP_EXECUTION_MODE, AP_NETWORK_MODE, AP_SSRF_ALLOW_LIST,
# AP_FLOW_TIMEOUT_SECONDS, AP_MAX_FILE_SIZE_MB) sono lette dall'APP e pushate
# al worker via socket: vanno quindi presenti sul servizio `app`. Le variabili
# di concorrenza/sandbox (AP_WORKER_CONCURRENCY, AP_REUSE_SANDBOX,
# AP_PREWARM_CACHE_ON_STARTUP) sono invece lette localmente dal worker.
# Tenerle in un unico `.env` evita disallineamenti.
#
# Community edition: `UNSANDBOXED` è il default supportato.
# Per isolare meglio il codice dei flow valuta `SANDBOX_CODE_ONLY`
# (vedi docs/security.md) e riavvia app + worker.
AP_EXECUTION_MODE=UNSANDBOXED
AP_FLOW_TIMEOUT_SECONDS=600

# Concorrenza del worker: quanti job in parallelo per container.
# Il default upstream è 5; con 1 il blast radius di un OOM resta su un solo flow.
# Aumentare il throughput aggiungendo repliche, non la concorrenza.
AP_WORKER_CONCURRENCY=1
# Riusa il sandbox caldo tra i job (consigliato con concorrenza 1).
AP_REUSE_SANDBOX=true
# Pre-riscalda la cache pezzi/codice all'avvio del worker. Default `false`:
# su istanze con molti flow può saturare CPU/memoria del worker. Lasciare off
# salvo esigenze di latenza al primo run.
AP_PREWARM_CACHE_ON_STARTUP=false

# --- Egress di rete del codice dei flow -------------------------------------
# `UNRESTRICTED` (default upstream) non applica guardie in uscita.
# `STRICT` installa la guardia SSRF in-process: blocca private/loopback/
# link-local/cloud-metadata dal codice dei flow.
# ATTENZIONE prima di passare a STRICT: va verificato che il worker riesca
# comunque a raggiungere l'app interna (http://app) e i servizi legittimi;
# in caso contrario aggiungerli a AP_SSRF_ALLOW_LIST (IP/CIDR, separati da
# virgola). Vedi docs/security.md §5.
AP_NETWORK_MODE=UNRESTRICTED
AP_SSRF_ALLOW_LIST=

# --- Limiti (default upstream, espliciti per chiarezza) ---------------------
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_MAX_FILE_SIZE_MB=25
AP_MAX_WEBHOOK_PAYLOAD_SIZE_MB=25
AP_MAX_FLOW_RUN_LOG_SIZE_MB=50

# --- Registrazioni ----------------------------------------------------------
# NON esiste `AP_SIGN_UP_ENABLED`. Il gate reale e' `AP_ALLOW_OPEN_SIGN_UP`:
#   - assente (default): su una piattaforma gia' esistente solo gli utenti
#     INVITATI possono registrarsi (errore `INVITATION_ONLY_SIGN_UP`).
#   - `true`: chiunque puo' registrarsi senza invito. Sconsigliato in produzione.
# Il primo signup assoluto (nessuna piattaforma nel DB) crea la piattaforma
# stessa (onboarding) e resta possibile a prescindere da questa variabile.
# Per aggiungere utenti usare l'invito da Platform Admin -> Users.
# AP_ALLOW_OPEN_SIGN_UP=false
# CAPTCHA anti-bot (opzionale). Senza TURNSTILE il signup pubblico non e' protetto.
# AP_TURNSTILE_SITE_KEY=
# AP_TURNSTILE_SECRET_KEY=
# Verifica email (opzionale).
# AP_ZEROBOUNCE_API_KEY=

# --- Branding (Fase 8) ------------------------------------------------------
# NESSUNA variabile d'ambiente per il branding: la Community edition ignora
# nome/logo/colori del DB e serve sempre `defaultTheme` ("Activepieces").
# Il brand Aethersy e' applicato via bind-mount dei file in `branding/`
# (vedi docker-compose.yml, servizio `app`) + patch di index.html.
#   - branding/theme.js  -> nome "Aethersy", colori, loghi locali
#   - branding/web/*      -> logo.svg, favicon.ico, logo-192/180.png, brand/
# Dopo un cambio di AP_VERSION esegui `scripts/05-branding.sh` (lo fa anche
# `03-deploy.sh`). Dettagli e limiti CE vs Enterprise in docs/phases.md (Fase 8).

# --- Edizione ---------------------------------------------------------------
# Community (default): lasciare vuoto/assente.
# Per attivare una licenza Enterprise servono AP_EDITION=ee E
# AP_EXECUTION_MODE=SANDBOX_CODE_ONLY (con `ee`, `UNSANDBOXED` è rifiutato
# all'avvio). Vedi docs/phases.md.
# AP_EDITION=ee

# --- Pieces -----------------------------------------------------------------
AP_PIECES_SYNC_MODE=OFFICIAL_AUTO
# Tool search semantica per gli agenti MCP (default off).
AP_TOOL_SEARCH_ENABLED=false
AP_OPENAI_API_KEY=

# --- Porta host (solo localhost, per health check) --------------------------
# NON impostare AP_PORT: è la porta interna del container e va lasciata a 80.
AP_HOST_PORT=8080

# --- Provider AI ------------------------------------------------------------
# IMPORTANTE: Activepieces NON legge i provider AI da variabili d'ambiente.
# Non esiste `AP_AI_PROVIDER` né una env per le chiavi dei provider. I provider
# si configurano a RUNTIME nella UI: Platform Admin -> AI Center -> Providers.
# Le variabili qui sotto sono quindi SOLO di riferimento/documentazione locale
# (non consumate dallo stack). La chiave va incollata nella UI di Activepieces.
#
# OpenRouter e' un provider "Gateway" nativo di Activepieces; Venice rientra in
# "Other (OpenAI Compatible)". Non esiste failover automatico tra provider in
# Activepieces: il failover va delegato a OpenRouter (provider failover + array
# `models`). Vedi docs/runbook.md §6.1 e docs/phases.md §11 voce 6.
#
# NOTA: la stessa chiave e' consumata dall'Aethersy Console (servizio `console`)
# per il suo AI Router (selezione automatica del modello per capacita').
OPENROUTER_API_KEY=
# --- Wix (server MCP ufficiale + API REST) ---------------------------------
# Il server MCP di Wix (https://mcp.wix.com/mcp) espone e-commerce, blog,
# analytics, pagine e domini come tool. La piattaforma si collega con OAuth 2.1
# (registrazione dinamica del client + PKCE): l'utente autorizza dal browser e
# i token restano cifrati nel database del tenant.
# Se WIX_MCP_CLIENT_ID/WIX_MCP_CLIENT_SECRET sono vuoti, la piattaforma
# registra un client dinamico al primo collegamento (DCR su /register).
WIX_MCP_CLIENT_ID=
WIX_MCP_CLIENT_SECRET=
WIX_MCP_SCOPE=offline_access
# Site ID del sito Wix su cui operare. Facoltativo: se assente o non valido,
# la piattaforma rileva il sito dall'account collegato (ListWixSites).
# Si legge in "Wix - Business" (riquadro "Sito Wix").
WIX_SITE_ID=
# Venice (endpoint OpenAI-compatible). NOTA: senza credito la chiave autentica
# ma ogni inferenza risponde "Insufficient USD or Diem balance".
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Replicate: fallback automatico quando Venice non risponde (img_out / tts / vid_out).
REPLICATE_API_KEY=
REPLICATE_BASE_URL=https://api.replicate.com/v1

# NVIDIA NIM (build.nvidia.com): provider LLM gratuito, usato dal Console per
# le rotte di chat quando OpenRouter non e' disponibile. Il modello viene
# scelto dal provider a partire dal catalogo live (`GET {NVIDIA_BASE_URL}/models`).
# Se la chiave manca il provider viene saltato silenziosamente.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_MS=90000
NVIDIA_MAX_TOKENS=8192

# GitHub OAuth (provider social login aggiuntivo).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Telegram Login (OIDC su oauth.telegram.org): Client ID e Client Secret
# forniti da @BotFather -> Login Widget. Con questi valori la piattaforma
# offre "Continua con Telegram" come metodo di accesso.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Callback che deve essere registrato come Allowed URL in BotFather.
TELEGRAM_REDIRECT_URI=https://platform.aethersy.online/api/auth/social/telegram/callback

# URL pubblici dei frontend: servono al redirect finale del login social
# (allowlist chiusa: platform | console). Se assenti si usano i default.
PLATFORM_PUBLIC_URL=https://platform.aethersy.online
CONSOLE_PUBLIC_URL=https://console.aethersy.online

# fal.ai API (generazione immagini/video). Usata dal Console come terzo
# livello di fallback per img_out (Venice -> Replicate -> fal.ai).
# I prezzi sono per megapixel (fal.ai/pricing): flux/schnell $0.003, flux/dev $0.025.
FAL_API_KEY=

# z.ai (Zhipu AI): terzo provider LLM del Console, endpoint OpenAI-compatible.
# Il free tier e' limitato ai modelli "*Flash" (GLM-4.5-Flash, GLM-4.7-Flash):
# i modelli a pagamento rispondono 429 "Insufficient balance" senza credito.
# Se la chiave manca il provider viene saltato silenziosamente dal router.
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
ZAI_TIMEOUT_MS=30000
ZAI_MAX_TOKENS=4096

# Stripe (chiave live): usata dai progetti generati dal builder per i pagamenti
# e destinata al sender della billing_outbox (metering -> Stripe). Non
# consumata dal BFF finche' il sender non e' implementato.
STRIPE_SECRET_KEY=

# --- Notifiche --------------------------------------------------------------
# Incoming webhook Slack (Fase 6: alert cron + flow Activepieces). Dalla P0.6
# e' anche il canale outbound di fallback della Console per i lead e le
# consegne; se vuoto le notifiche della Console sono un no-op.
SLACK_WEBHOOK_URL=

# --- Reverse proxy / TLS ----------------------------------------------------
# Email per la registrazione ACME di Let's Encrypt.
ACME_EMAIL=ops@aethersy.online
# Hostname pubblici serviti da Caddy (devono combaciare con AP_FRONTEND_URL /
# AP_MCP_URL). Dominio definitivo: aethersy.online (GoDaddy).
APP_DOMAIN=app.aethersy.online
MCP_DOMAIN=mcp.aethersy.online
# Apex + www: solo redirect 301 verso APP_DOMAIN.
APEX_DOMAIN=aethersy.online

# --- Aethersy Console (fusion A+B+C) ----------------------------------------
# Frontend proprietario + BFF (cartella ./console). Esposto su CONSOLE_DOMAIN.
# Richiede un record A `console` -> IP del VPS nel pannello DNS.
CONSOLE_DOMAIN=console.aethersy.online
CONSOLE_VERSION=0.1.0
# Segreto per firmare il cookie di sessione httpOnly del BFF.
# Genera con: openssl rand -hex 32
CONSOLE_SESSION_SECRET=CHANGEME_openssl_rand_hex_32
# Dominio del cookie di sessione BFF. Vuoto = host-only. Impostare a
# `.aethersy.online` per condividere il login tra Console (backoffice) e il sito
# Platform (che proxa /api verso il BFF): un'unica sessione su tutti i sottodomini.
CONSOLE_COOKIE_DOMAIN=.aethersy.online

# --- Aethersy Platform (technical brief) ------------------------------------
# SPA React mock-first servita da nginx (cartella ./platform), sito dedicato.
# Richiede un record A `platform` -> IP del VPS nel pannello DNS.
# La stessa app e' anche dentro la Console come layer anteprima (/preview).
PLATFORM_DOMAIN=platform.aethersy.online
PLATFORM_VERSION=0.1.0

# --- Metering / billing (piattaforma a consumo) -----------------------------
# Kill-switch: `true` abilita prenotazione e addebito del consumo AI.
# Richiede Postgres (schema `metering`, creato all'avvio) e Redis (rate limit).
# Con `false` le rotte AI restano attive ma non metrate (nessun addebito).
METERING_ENABLED=false
# Richieste AI al minuto per tenant/chiave (rate limit Redis).
METERING_RATE_PER_MINUTE=120
# Crediti di benvenuto assegnati al provisioning del primo accesso (0 = nessuno).
# 1 credito = 0.0001 EUR (vedi docs/platform-consumption.md §3).
METERING_SIGNUP_CREDITS=0
# NOTA: il servizio `console` del compose riceve i parametri discreti
# `CONSOLE_PGHOST/PGPORT/PGUSER/PGPASSWORD/PGDATABASE` da AP_POSTGRES_* e
# `CONSOLE_REDIS_*` da AP_REDIS_PASSWORD. Nessuna URL con credenziali da encodare.

# Chiave per cifrare a riposo i segreti delle integrazioni (P0.6, AES-256-GCM:
# webhook Slack/token dei tenant). Esadecimale di 64 caratteri:
#   openssl rand -hex 32
# Se vuota si usa `AP_ENCRYPTION_KEY` (stessa chiave dello stack): cosi' non
# c'e' un secondo segreto da custodire, ma ruotarla invalida i blob salvati.
# Per ruotarla in autonomia, imposta un valore dedicato e NON riciclare quello
# di Activepieces. Se entrambe sono assenti, le integrazioni rispondono 503.
CONSOLE_SECRETS_KEY=

# Immagine Docker usata dal builder per eseguire i task degli agenti
# (console/server/src/builder/agents/sandbox.ts). Deve esistere sul VPS:
#   docker build -t aethersy/builder-sandbox:0.1.0 console/server/builder-sandbox
BUILDER_SANDBOX_IMAGE=aethersy/builder-sandbox:0.1.0

# --- Sistema ----------------------------------------------------------------
TZ=Europe/Rome

# Notifiche e deploy -------------------------------------------------------------
# Token del hook di deploy: il processo di deploy lo chiama per registrare la
# notifica di deploy in piattaforma (in-app + Slack + webhook in uscita).
# Genera con: openssl rand -hex 32
DEPLOY_HOOK_TOKEN=
# Versione e commit mostrati nella notifica di deploy.
APP_VERSION=dev
DEPLOY_COMMIT=
DEPLOY_SERVICES=console, platform

# --- Amministrazione e Jarvis (Fase 35) --------------------------------------
# Email degli amministratori (separate da virgola). Gli admin consumano i
# provider senza essere addebitati: il costo resta visibile nel pannello di
# controllo, i crediti non vengono scalati e i blocchi per saldo non valgono.
ADMIN_EMAILS=mattiadeblasio94@gmail.com

# Jarvis: l'assistente vocale della piattaforma, ospitato su un VPS dedicato.
# La piattaforma lo chiama (chat + trascrizione); Jarvis richiama la
# piattaforma con i suoi tool. Se vuoto, la sezione Jarvis resta disattivata.
JARVIS_BASE_URL=
JARVIS_API_KEY=
JARVIS_TIMEOUT_MS=120000
JARVIS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Modello di riserva quando il primario e' saturo (quota o rate limit).
JARVIS_MODEL_FALLBACK=gemini-3.6-flash
# Budget (ms) del modello primario e del modello di riserva.
JARVIS_PRIMARY_TIMEOUT_MS=15000
# Token condiviso col watcher per gli eventi proattivi.
JARVIS_EVENTS_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# Voce pubblica ElevenLabs "Brian" (ID, non nome): multilingue, maschile.
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb
# Flash = latenza minima per il dialogo; multilingual_v2 = massima fedelta'.
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SCRIBE_MODEL=scribe_v1
ELEVENLABS_STT_ENABLED=true
