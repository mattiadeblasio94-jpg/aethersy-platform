# =============================================================================
# Jarvis — ambiente del VPS dedicato. Copiare su .env e completare.
# Nessun segreto nel repository: questo file e' solo il modello.
# =============================================================================

# Dominio pubblico di Jarvis (record A -> IP del VPS dedicato).
JARVIS_DOMAIN=jarvis.aethersy.online
ACME_EMAIL=admin@aethersy.online

# --- Engine LLM (i provider gia' configurati: niente Ollama) -----------------
# NVIDIA integrate API (engine "nim"): tool-calling verificato.
NIM_API_KEY=
# z.ai (GLM free) e OpenRouter come engine alternativi.
ZAI_API_KEY=
OPENROUTER_API_KEY=

# --- Piattaforma Aethersy (i tool di Jarvis) ---------------------------------
AETHERSY_API_BASE=https://platform.aethersy.online
# Credenziali di un account utente della piattaforma ( Jarvis usa i tool).
AETHERSY_EMAIL=
AETHERSY_PASSWORD=
# Chiave API del tenant (alternativa al login; ha la precedenza se presente).
AETHERSY_API_KEY=
# Repository della piattaforma montato nel container (coding agent).
AETHERSY_REPO=/opt/aethersy-infra

# --- Voce --------------------------------------------------------------------
# Sintesi: la piattaforma espone gia' il TTS (Venice/kokoro) via /api/ai/generate.
AETHERSY_TTS_VOICE=af_sky
AETHERSY_TTS_LANGUAGE=it

# --- Deploy ------------------------------------------------------------------
JARVIS_VERSION=0.1.0
OPENJARVIS_REPO=https://github.com/mattiadeblasio94-jpg/OpenJarvis.git
OPENJARVIS_REF=main
