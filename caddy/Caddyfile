# Caddyfile — reverse proxy + TLS per aethersy
#
# Hostname pubblici (tutti parametrizzati via .env):
#   {$APP_DOMAIN}          -> app Activepieces (UI + API + webhook)
#   {$MCP_DOMAIN}          -> solo le route MCP / OAuth
#   {$CONSOLE_DOMAIN}      -> Aethersy Console (frontend proprietario + BFF)
#   {$APEX_DOMAIN}         -> redirect 301 verso APP_DOMAIN
#   www.{$APEX_DOMAIN}     -> redirect 301 verso APP_DOMAIN
#
# App e Console sono container distinti (app:80 / console:3000).
# Activepieces riconosce le richieste MCP dall'hostname, quindi l'header
# Host pubblico viene preservato (vedi header_up Host {host}).
{
	email {$ACME_EMAIL}
}

# -----------------------------------------------------------------------------
# Snippet: inoltro generico verso l'app (UI, API, webhook, consent screen MCP).
# -----------------------------------------------------------------------------
(app_proxy) {
	encode zstd gzip

	# Consenti upload fino a 25 MB (default AP_MAX_FILE_SIZE_MB / webhook payload).
	request_body {
		max_size 25MB
	}

	reverse_proxy app:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# -----------------------------------------------------------------------------
# Snippet: solo le route documentate MCP/OAuth. Tutto il resto risponde 404.
# Riferimento: docs Activepieces -> "Serving MCP from its own hostname".
# -----------------------------------------------------------------------------
(mcp_proxy) {
	encode zstd gzip

	# Match esatto: /mcp e /mcp/platform.
	# (una regola di prefisso /mcp matcherebbe anche /mcp-authorize, che questo
	#  hostname NON deve servire)
	@mcp path /mcp /mcp/platform
	handle @mcp {
		reverse_proxy app:80 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Endpoint OAuth.
	@oauth path /authorize /token /register /revoke /userinfo
	handle @oauth {
		reverse_proxy app:80 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Well-known statici.
	@wellknown path /.well-known/oauth-authorization-server /.well-known/openid-configuration /.well-known/jwks.json
	handle @wellknown {
		reverse_proxy app:80 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Well-known con wildcard.
	@protected path /.well-known/oauth-protected-resource/*
	handle @protected {
		reverse_proxy app:80 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Nessuna route MCP nota: 404 esplicito.
	handle {
		respond "Not found" 404
	}
}

# -----------------------------------------------------------------------------
# App: UI, API, webhook, e la consent screen MCP (/mcp-authorize).
# -----------------------------------------------------------------------------
{$APP_DOMAIN} {
	import app_proxy
}

# -----------------------------------------------------------------------------
# Console: frontend proprietario Aethersy + BFF (container `console:3000`).
# -----------------------------------------------------------------------------
{$CONSOLE_DOMAIN} {
	encode zstd gzip
	reverse_proxy console:3000 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

# -----------------------------------------------------------------------------
# MCP: hostname dedicato.
# -----------------------------------------------------------------------------
{$MCP_DOMAIN} {
	import mcp_proxy
}

# -----------------------------------------------------------------------------
# Apex e www: nessun sito, solo redirect verso l'app.
# -----------------------------------------------------------------------------
{$APEX_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}

www.{$APEX_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri} permanent
}
