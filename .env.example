# =============================================================================
# aethersy — variabili d'ambiente
# Copia questo file in `.env` e compila i valori. MAI committare `.env`.
#   cp .env.example .env
# Genera i segreti con:
#   openssl rand -hex 16   -> AP_ENCRYPTION_KEY (32 hex char)
#   openssl rand -hex 32   -> AP_JWT_SECRET, AP_POSTGRES_PASSWORD, AP_REDIS_PASSWORD
# =============================================================================

# --- Versione immagine (pin obbligatorio, mai `latest`) ----------------------
# Ultima release stabile verificata su GitHub: 0.92.3-hotfix.1 (23/10/2026)
AP_VERSION=0.92.3-hotfix.1

# --- Core -------------------------------------------------------------------
AP_ENVIRONMENT=prod
# URL pubblico usato per webhook e redirect. DEVE essere raggiungibile da terzi.
AP_FRONTEND_URL=https://app.aethersy.com
# Hostname dedicato per il traffico MCP. Obbligatoriamente diverso da AP_FRONTEND_URL.
AP_MCP_URL=https://mcp.aethersy.com

# 32 caratteri hex (16 byte) — cifra le credenziali delle connessioni.
# SE PERSA, le connessioni salvate diventano irrecuperabili. Salvala offline.
AP_ENCRYPTION_KEY=CHANGEME_openssl_rand_hex_16
# 32 caratteri hex — firma i JWT.
AP_JWT_SECRET=CHANGEME_openssl_rand_hex_32

AP_TELEMETRY_ENABLED=false

# --- Database ---------------------------------------------------------------
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_HOST=postgres
AP_POSTGRES_PORT=5432
AP_POSTGRES_USERNAME=postgres
AP_POSTGRES_PASSWORD=CHANGEME_openssl_rand_hex_32

# --- Redis & queue ----------------------------------------------------------
AP_REDIS_HOST=redis
AP_REDIS_PORT=6379
# Redis gira con requirepass (vedi docker-compose.yml): user `default`.
AP_REDIS_USER=default
AP_REDIS_PASSWORD=CHANGEME_openssl_rand_hex_32
# Dashboard BullMQ. Richiede credenziali proprie se abilitata.
AP_QUEUE_UI_ENABLED=false
AP_QUEUE_UI_USERNAME=
AP_QUEUE_UI_PASSWORD=

# --- Esecuzione -------------------------------------------------------------
# NOTA: app e worker condividono questo `.env` (env_file). Le variabili di
# esecuzione/rete (AP_EXECUTION_MODE, AP_NETWORK_MODE, AP_SSRF_ALLOW_LIST,
# AP_FLOW_TIMEOUT_SECONDS, AP_MAX_FILE_SIZE_MB) sono lette dall'APP e pushate
# al worker via socket: vanno quindi presenti sul servizio `app`. Le variabili
# di concorrenza/sandbox (AP_WORKER_CONCURRENCY, AP_REUSE_SANDBOX,
# AP_PREWARM_CACHE_ON_STARTUP) sono invece lette localmente dal worker.
# Tenerle in un unico `.env` evita disallineamenti.
#
# Community edition: `UNSANDBOXED` è il default supportato.
# Per isolare meglio il codice dei flow valuta `SANDBOX_CODE_ONLY`
# (vedi docs/security.md) e riavvia app + worker.
AP_EXECUTION_MODE=UNSANDBOXED
AP_FLOW_TIMEOUT_SECONDS=600

# Concorrenza del worker: quanti job in parallelo per container.
# Il default upstream è 5; con 1 il blast radius di un OOM resta su un solo flow.
# Aumentare il throughput aggiungendo repliche, non la concorrenza.
AP_WORKER_CONCURRENCY=1
# Riusa il sandbox caldo tra i job (consigliato con concorrenza 1).
AP_REUSE_SANDBOX=true
# Pre-riscalda la cache pezzi/codice all'avvio del worker. Default `false`:
# su istanze con molti flow può saturare CPU/memoria del worker. Lasciare off
# salvo esigenze di latenza al primo run.
AP_PREWARM_CACHE_ON_STARTUP=false

# --- Egress di rete del codice dei flow -------------------------------------
# `UNRESTRICTED` (default upstream) non applica guardie in uscita.
# `STRICT` installa la guardia SSRF in-process: blocca private/loopback/
# link-local/cloud-metadata dal codice dei flow.
# ATTENZIONE prima di passare a STRICT: va verificato che il worker riesca
# comunque a raggiungere l'app interna (http://app) e i servizi legittimi;
# in caso contrario aggiungerli a AP_SSRF_ALLOW_LIST (IP/CIDR, separati da
# virgola). Vedi docs/security.md §5.
AP_NETWORK_MODE=UNRESTRICTED
AP_SSRF_ALLOW_LIST=

# --- Limiti (default upstream, espliciti per chiarezza) ---------------------
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_MAX_FILE_SIZE_MB=25
AP_MAX_WEBHOOK_PAYLOAD_SIZE_MB=25
AP_MAX_FLOW_RUN_LOG_SIZE_MB=50

# --- Edizione ---------------------------------------------------------------
# Community (default): lasciare vuoto/assente.
# Per attivare una licenza Enterprise servono AP_EDITION=ee E
# AP_EXECUTION_MODE=SANDBOX_CODE_ONLY (con `ee`, `UNSANDBOXED` è rifiutato
# all'avvio). Vedi docs/phases.md.
# AP_EDITION=ee

# --- Pieces -----------------------------------------------------------------
AP_PIECES_SYNC_MODE=OFFICIAL_AUTO
# Tool search semantica per gli agenti MCP (default off).
AP_TOOL_SEARCH_ENABLED=false
AP_OPENAI_API_KEY=

# --- Porta host (solo localhost, per health check) --------------------------
# NON impostare AP_PORT: è la porta interna del container e va lasciata a 80.
AP_HOST_PORT=8080

# --- Provider AI ------------------------------------------------------------
# IMPORTANTE: Activepieces NON legge i provider AI da variabili d'ambiente.
# Non esiste `AP_AI_PROVIDER` né una env per le chiavi dei provider. I provider
# si configurano a RUNTIME nella UI: Platform Admin -> AI Center -> Providers.
# Le variabili qui sotto sono quindi SOLO di riferimento/documentazione locale
# (non consumate dallo stack). La chiave va incollata nella UI di Activepieces.
#
# OpenRouter e' un provider "Gateway" nativo di Activepieces; Venice rientra in
# "Other (OpenAI Compatible)". Non esiste failover automatico tra provider in
# Activepieces: il failover va delegato a OpenRouter (provider failover + array
# `models`). Vedi docs/runbook.md §6.1 e docs/phases.md §11 voce 6.
OPENROUTER_API_KEY=
# Venice (endpoint OpenAI-compatible). NOTA: senza credito la chiave autentica
# ma ogni inferenza risponde "Insufficient USD or Diem balance".
VENICE_API_KEY=
VENICE_BASE_URL=https://api.venice.ai/api/v1

# --- Notifiche --------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Reverse proxy / TLS ----------------------------------------------------
# Email per la registrazione ACME di Let's Encrypt.
ACME_EMAIL=ops@aethersy.com

# --- Sistema ----------------------------------------------------------------
TZ=Europe/Rome
